{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            ".github/**"
        ],
        "headers": [
            {
                "source": "/mypars/schedule.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=60"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            },
            {
                "source": "/",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            },
            {
                "source": "/mypars/",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            },
            {
                "source": "/mypars/library/",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300"
                    }
                ]
            },
            {
                "source": "**/sw.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ]
    }
}
